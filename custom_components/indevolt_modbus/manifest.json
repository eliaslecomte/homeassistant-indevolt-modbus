{
  "domain": "indevolt_modbus",
  "name": "Indevolt Modbus",
  "codeowners": [
    "@eliaslecomte"
  ],
  "config_flow": true,
  "dependencies": [
    "modbus"
  ],
  "documentation": "https://github.com/eliaslecomte/homeassistant-indevolt-modbus",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/eliaslecomte/homeassistant-indevolt-modbus/issues",
  "loggers": [
    "indevolt_modbus",
    "modbus_connection",
    "tmodbus"
  ],
  "requirements": [
    "indevolt-modbus==0.1.0"
  ],
  "version": "0.2.11",
  "zeroconf": [
    {
      "name": "igen_fw*",
      "type": "_http._tcp.local."
    }
  ]
}
